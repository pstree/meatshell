import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";

// 编辑器修改：内置 SFTP 文件查看 / 编辑对话框。
// 该组件由 app.slint 抽出并放入 sftp 模块（qian 分支特性：语法高亮 + 查找定位文本 /
// 滚动到匹配行 + 自绘闪烁光标）。Rust 侧仍通过 AppWindow 的 editor-* 属性与回调访问，
// AppWindow 只负责声明属性/回调并转发给本组件。

export struct EditorFindResult {
    start: int,
    end: int,
    count: int,
}

export component SFTPEditor inherits Rectangle {
    // --- 编辑器修改：与 AppWindow 绑定的编辑器状态 --------------------------
    // in-out 表示组件与 AppWindow 双向同步（编辑、查询、替换、计数、当前匹配位置）。
    in-out property <string> editor-content;
    in-out property <string> editor-find-query;
    in-out property <string> editor-replace-text;
    in-out property <int> editor-match-count: 0;
    in-out property <int> editor-find-position: -1;
    // 只读展示类（由 AppWindow 单向下发）。
    in property <string> editor-name;
    in property <string> editor-line-numbers;
    in property <string> editor-comment-text: ""; // 语法高亮：注释行（绿色）
    in property <string> editor-normal-text: "";  // 语法高亮：普通行
    in property <bool> editor-readonly;
    in-out property <bool> editor-dirty: false; // 编辑后置真（同步给 AppWindow 标题）

    // --- 编辑器修改：转发到 AppWindow / Rust 的回调 -------------------------
    callback save-file();                    // Ctrl+S / 保存按钮
    callback close-editor();                 // X / Esc；关闭不自动上传
    callback editor-recount(string);         // 重建行号 + 刷新语法高亮
    callback editor-count-matches(string, string) -> int;
    callback editor-find-step(string, string, int, bool) -> EditorFindResult;
    callback editor-replace-all(string, string);
    // 查找定位文本（#287）：把字节偏移→可视行号等，供滚动居中匹配行。
    callback editor-line-index-at(string, int) -> int;
    callback editor-line-count(string) -> int;
    callback editor-byte-length-of(string) -> int;

    // --- 编辑器修改：卡片几何（组件内部状态，不参与 AppWindow 转发） ---------
    property <length> ed-w: 760px;
    property <length> ed-h: 560px;
    property <length> ed-x: (root.width - self.ed-w) / 2;
    property <length> ed-y: (root.height - self.ed-h) / 2;
    property <bool> ed-dragging;
    property <bool> ed-resizing;
    property <length> ed-base-x;
    property <length> ed-base-y;
    property <length> ed-base-w;
    property <length> ed-base-h;
    property <length> ed-grab-x;
    property <length> ed-grab-y;

    // 全屏遮罩根：铺满父窗口（尺寸由 app.slint 实例化处设定）。点击它不会关闭
    // （避免误触丢失编辑），并吞掉滚动事件防止透传到下方终端（#70）。
    background: #00000088;

    TouchArea {
        scroll-event(event) => { accept }
    }
    edit-fs := FocusScope {
        // Ctrl+S saves, Esc closes. These bubble up from the focused
        // TextInput because it doesn't consume them.
        key-pressed(e) => {
            // ⌘S on macOS, Ctrl+S elsewhere. (Slint maps `control` to Cmd on
            // macOS — see #158, so no platform branch is needed here.) On macOS
            // Cmd+letter arrives as the C0 control char (Cmd+S = "\u{13}"), not
            // "s" — confirmed on an M4 — so accept both forms (#158).
            if (e.modifiers.control && (e.text == "s" || e.text == "S" || e.text == "\u{0013}")) {
                root.save-file();
                return accept;
            }
            if (e.text == Key.Escape) {
                root.close-editor();
                return accept;
            }
            return reject;
        }
        Rectangle {
            x: root.ed-x;
            y: root.ed-y;
            width: root.ed-w;
            height: root.ed-h;
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000080;
            clip: true;

            VerticalLayout {
                // Title bar — drag to move; the buttons stay on top.
                Rectangle {
                    height: 40px;
                    background: Theme.popup-bg-alt;
                    ed-title-drag := TouchArea {
                        mouse-cursor: move;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                root.ed-dragging = true;
                                root.ed-base-x = root.ed-x;
                                root.ed-base-y = root.ed-y;
                                root.ed-grab-x = self.absolute-position.x + self.mouse-x;
                                root.ed-grab-y = self.absolute-position.y + self.mouse-y;
                            } else if (e.kind == PointerEventKind.up) {
                                root.ed-dragging = false;
                            }
                        }
                        moved => {
                            if (root.ed-dragging) {
                                root.ed-x = root.ed-base-x + (self.absolute-position.x + self.mouse-x - root.ed-grab-x);
                                root.ed-y = root.ed-base-y + (self.absolute-position.y + self.mouse-y - root.ed-grab-y);
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 8px;
                        // Centre the 28px buttons inside the 40px bar so the
                        // Save button isn't glued to the top edge (#70).
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 8px;
                        Text {
                            text: root.editor-name
                                + (root.editor-readonly
                                    ? "  ·  " + @tr("Read-only")
                                    : (root.editor-dirty ? "  ·  " + @tr("Modified") : ""));
                            color: Theme.text-primary;
                            font-size: Theme.fs-md;
                            font-weight: 600;
                            font-family: Theme.ui-font-family;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        if !root.editor-readonly : Rectangle {
                            width: 76px; height: 28px;
                            border-radius: Theme.radius-sm;
                            background: ed-save-ta.has-hover ? Theme.accent-hover : Theme.accent;
                            ed-save-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.save-file(); }
                            }
                            Text { text: @tr("Save"); color: #ffffff; font-size: Theme.fs-sm;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: 28px; height: 28px;
                            border-radius: Theme.radius-sm;
                            background: ed-close-ta.has-hover ? Theme.bg-hover : transparent;
                            ed-close-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.close-editor(); }
                            }
                            Text { text: "\u{E5CD}"; font-family: "Material Icons";
                                   color: Theme.text-secondary; font-size: Theme.fs-md;
                                   horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border-subtle; }

                // Lightweight find/replace bar (#287). Replacement is
                // explicit; closing the editor never writes the file.
                Rectangle {
                    height: 38px;
                    background: Theme.popup-bg;
                    HorizontalLayout {
                        // 编辑器修改：整条查找/替换栏水平居中（#287）。
                        alignment: center;
                        padding-left: 8px; padding-right: 8px;
                        padding-top: 5px; padding-bottom: 5px; spacing: 6px;
                        Text { text: @tr("Find"); color: Theme.text-muted; vertical-alignment: center; }
                        TextInput {
                            preferred-width: 160px;
                            single-line: true;
                            // 编辑器修改：文字垂直居中，与同栏按钮/标签对齐。
                            vertical-alignment: center;
                            text <=> root.editor-find-query;
                            edited => {
                                root.editor-find-position = -1;
                                root.editor-match-count = root.editor-count-matches(
                                    root.editor-content, root.editor-find-query);
                                // 编辑器修改：查找定位文本（#287）——输入查询词时
                                // 立即滚动并居中到第一个匹配行。
                                if (root.editor-match-count > 0) {
                                    let found = root.editor-find-step(
                                        root.editor-content, root.editor-find-query, -1, false);
                                    root.editor-find-position = found.start;
                                    edit-input.set-selection-offsets(found.start, found.end);
                                    // 用匹配字节偏移推算可视行号，滚动到该行并居中。
                                    let line-index = root.editor-line-index-at(root.editor-content, found.start);
                                    let n-lines = root.editor-line-count(root.editor-content);
                                    let line-height = edit-input.preferred-height / max(1, n-lines);
                                    let match-y = edit-input.y + line-height * line-index;
                                    let target-top = max(0px, match-y - max(0px, ed-scroll.visible-height / 2 - line-height));
                                    let min-y = min(0px, ed-scroll.visible-height - ed-scroll.viewport-height);
                                    ed-scroll.viewport-y = max(min-y, min(0px, -target-top));
                                }
                            }
                        }
                        Text {
                            width: 42px;
                            text: root.editor-find-query == "" ? "" : root.editor-match-count;
                            color: Theme.text-muted;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        Rectangle {
                            width: 28px;
                            border-radius: Theme.radius-sm;
                            background: find-prev-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                            find-prev-ta := TouchArea {
                                enabled: root.editor-match-count > 0;
                                clicked => {
                                    let found = root.editor-find-step(root.editor-content,
                                        root.editor-find-query, root.editor-find-position, true);
                                    root.editor-find-position = found.start;
                                    root.editor-match-count = found.count;
                                    edit-input.set-selection-offsets(found.start, found.end);
                                    edit-input.focus();
                                    // 编辑器修改：查找定位文本（#287）——上一处，
                                    // 滚动并居中到匹配行。
                                    let line-index = root.editor-line-index-at(root.editor-content, found.start);
                                    let n-lines = root.editor-line-count(root.editor-content);
                                    let line-height = edit-input.preferred-height / max(1, n-lines);
                                    let match-y = edit-input.y + line-height * line-index;
                                    let target-top = max(0px, match-y - max(0px, ed-scroll.visible-height / 2 - line-height));
                                    let min-y = min(0px, ed-scroll.visible-height - ed-scroll.viewport-height);
                                    ed-scroll.viewport-y = max(min-y, min(0px, -target-top));
                                }
                            }
                            Text { text: "↑"; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Rectangle {
                            width: 28px;
                            border-radius: Theme.radius-sm;
                            background: find-next-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                            find-next-ta := TouchArea {
                                enabled: root.editor-match-count > 0;
                                clicked => {
                                    let found = root.editor-find-step(root.editor-content,
                                        root.editor-find-query, root.editor-find-position, false);
                                    root.editor-find-position = found.start;
                                    root.editor-match-count = found.count;
                                    edit-input.set-selection-offsets(found.start, found.end);
                                    edit-input.focus();
                                    // 编辑器修改：查找定位文本（#287）——下一处，
                                    // 滚动并居中到匹配行。
                                    let line-index = root.editor-line-index-at(root.editor-content, found.start);
                                    let n-lines = root.editor-line-count(root.editor-content);
                                    let line-height = edit-input.preferred-height / max(1, n-lines);
                                    let match-y = edit-input.y + line-height * line-index;
                                    let target-top = max(0px, match-y - max(0px, ed-scroll.visible-height / 2 - line-height));
                                    let min-y = min(0px, ed-scroll.visible-height - ed-scroll.viewport-height);
                                    ed-scroll.viewport-y = max(min-y, min(0px, -target-top));
                                }
                            }
                            Text { text: "↓"; color: Theme.text-primary; horizontal-alignment: center; vertical-alignment: center; }
                        }
                        Text { text: @tr("Replace"); color: Theme.text-muted; vertical-alignment: center; }
                        TextInput {
                            preferred-width: 160px;
                            single-line: true;
                            // 编辑器修改：文字垂直居中，与同栏按钮/标签对齐。
                            vertical-alignment: center;
                            text <=> root.editor-replace-text;
                        }
                        Rectangle {
                            width: 88px;
                            border-radius: Theme.radius-sm;
                            background: replace-all-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                            replace-all-ta := TouchArea {
                                enabled: !root.editor-readonly && root.editor-find-query != "";
                                clicked => {
                                    root.editor-replace-all(root.editor-find-query, root.editor-replace-text);
                                }
                            }
                            Text {
                                text: @tr("Replace all");
                                color: replace-all-ta.enabled ? Theme.text-primary : Theme.text-muted;
                                font-size: Theme.fs-sm;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border-subtle; }

                // Text area: a line-number gutter on the left + the editor.
                // word-wrap is OFF so one logical line == one display line and
                // the numbers line up (long lines scroll horizontally); the
                // gutter is pinned horizontally but tracks the editor's
                // vertical scroll via ed-scroll.viewport-y (#81).
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg-root;
                    HorizontalLayout {
                        spacing: 0;
                        Rectangle {
                            width: 48px;
                            background: Theme.bg-panel-alt;
                            clip: true;
                            Text {
                                x: 0;
                                y: ed-scroll.viewport-y + 8px;
                                width: parent.width - 6px;
                                text: root.editor-line-numbers;
                                horizontal-alignment: right;
                                font-family: Theme.ui-font-family;
                                font-size: Theme.fs-md;
                                color: Theme.text-muted;
                            }
                        }
                        Rectangle { width: 1px; background: Theme.border-subtle; }
                        ed-scroll := ScrollView {
                            viewport-width: max(self.visible-width, edit-input.preferred-width + 16px);
                            viewport-height: max(self.visible-height, edit-input.preferred-height + 16px);

                            // --- 编辑器修改：语法高亮（qian 分支特性） ---
                            // 在近透明输入框之下绘制两层着色文本：`#` 注释行绿色，
                            // 其余普通行使用前景色；TextInput 只负责选区与自绘光标。
                            Text {
                                x: edit-input.x;
                                y: edit-input.y;
                                width: edit-input.width;
                                height: edit-input.height;
                                text: root.editor-comment-text;
                                color: Theme.success;
                                font-family: Theme.ui-font-family;
                                font-size: Theme.fs-md;
                                wrap: no-wrap;
                            }
                            Text {
                                x: edit-input.x;
                                y: edit-input.y;
                                width: edit-input.width;
                                height: edit-input.height;
                                text: root.editor-normal-text;
                                color: Theme.text-primary;
                                font-family: Theme.ui-font-family;
                                font-size: Theme.fs-md;
                                wrap: no-wrap;
                            }

                            // 编辑器修改：自绘光标——TextInput 文字近透明（以透出高亮层），
                            // 其原生光标也随之不可见，因此自绘一个闪烁的块状光标。
                            private property <length> ed-cursor-x: 0px;
                            private property <length> ed-cursor-y: 0px;
                            private property <bool> ed-cursor-visible: true;
                            ed-cursor-blink := Timer {
                                interval: 500ms;
                                running: edit-input.has-focus && !root.editor-readonly;
                                triggered => { ed-cursor-visible = !ed-cursor-visible; }
                            }

                            edit-input := TextInput {
                                x: 8px;
                                y: 8px;
                                width: max(parent.visible-width - 16px, self.preferred-width);
                                height: self.preferred-height;
                                text <=> root.editor-content;
                                read-only: root.editor-readonly;
                                single-line: false;
                                wrap: no-wrap;
                                // 编辑器修改：文字近透明，由下方高亮层着色；仅显示选区。
                                color: Theme.text-primary.with-alpha(0.01);
                                selection-background-color: Theme.accent;
                                selection-foreground-color: white;
                                font-family: Theme.ui-font-family;
                                font-size: Theme.fs-md;
                                edited => {
                                    root.editor-dirty = true;
                                    root.editor-recount(root.editor-content);
                                    root.editor-match-count = root.editor-count-matches(
                                        root.editor-content, root.editor-find-query);
                                }
                                cursor-position-changed(pos) => {
                                    ed-cursor-x = pos.x;
                                    ed-cursor-y = pos.y;
                                }
                            }

                            // 编辑器修改：自绘光标图形本身（闪烁块状光标）。
                            Rectangle {
                                visible: edit-input.has-focus && !root.editor-readonly;
                                x: edit-input.x + ed-cursor-x;
                                y: edit-input.y + ed-cursor-y;
                                width: 2px;
                                height: edit-input.font-size * 1.2;
                                background: Theme.text-primary;
                                opacity: ed-cursor-visible ? 1 : 0;
                                animate x { duration: 50ms; }
                                animate y { duration: 50ms; }
                                animate opacity { duration: 100ms; }
                            }
                        }
                    }
                }
            }

            // Bottom-right resize grip (#70).
            Rectangle {
                x: parent.width - 18px;
                y: parent.height - 18px;
                width: 18px;
                height: 18px;
                ed-resize-ta := TouchArea {
                    mouse-cursor: nwse-resize;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.ed-resizing = true;
                            root.ed-base-w = root.ed-w;
                            root.ed-base-h = root.ed-h;
                            root.ed-grab-x = self.absolute-position.x + self.mouse-x;
                            root.ed-grab-y = self.absolute-position.y + self.mouse-y;
                        } else if (e.kind == PointerEventKind.up) {
                            root.ed-resizing = false;
                        }
                    }
                    moved => {
                        if (root.ed-resizing) {
                            root.ed-w = max(420px, root.ed-base-w + (self.absolute-position.x + self.mouse-x - root.ed-grab-x));
                            root.ed-h = max(280px, root.ed-base-h + (self.absolute-position.y + self.mouse-y - root.ed-grab-y));
                        }
                    }
                }
                Text {
                    text: "◢";
                    color: ed-resize-ta.has-hover ? Theme.text-secondary : Theme.text-muted;
                    font-size: 10px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        // Focus the text the moment the editor opens.
        init => { edit-input.focus(); }
    }
}